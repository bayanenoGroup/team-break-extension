{
  "manifest_version": 3,
  "name": "نَفَس — استراحت تیمی",
  "short_name": "نَفَس",
  "version": "1.0.0",
  "description": "تایمر استراحت هماهنگ برای تیم‌ها: پومودورو، ۵۲/۱۷ و ۹۰/۲۰، با پیام‌های طنز برای وقت استراحت.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "نَفَس — استراحت تیمی",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["alarms", "storage", "notifications"],
  "minimum_chrome_version": "116"
}
